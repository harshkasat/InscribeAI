      "content": [
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          },
          "content": [
            {
              "type": "text",
              "text": "Tip: When working with multimodal inputs, ensure your data is preprocessed correctly to match the model's expected input format. This often involves resizing images, normalizing audio, or tokenizing text."
