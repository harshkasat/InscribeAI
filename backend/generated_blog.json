    },
    {
      "type": "paragraph",
      "attrs": {
        "textAlign": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Let's walk through the steps to get started with Gemma 3n. This section provides a clear, step-by-step guide to help you integrate Gemma into your projects. From setting up the environment to running your first inference, we've got you covered. Remember to adapt the instructions to your specific needs and always refer to the official documentation for detailed information."
        }
      ]
    },
