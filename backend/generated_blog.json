          "type": "text",
          "marks": [
            {
              "type": "bold"
            }
          ],
          "text": "indentation errors"
        },
        {
          "type": "text",
          "text": ". Unlike languages using curly braces, Python relies on whitespace (spaces or tabs) to define code blocks like loops or conditional statements. "
        },
        {
          "type": "text",
          "marks": [
            {
              "type": "italic"
            }
          ],
          "text": "Inconsistent indentation will stop your code from running"
        },
        {
          "type": "text",
          "text": ". Always use the same number of spaces (the convention is 4) for each indentation level."
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "textAlign": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Another common trap is "
